{
  "name": "@lemonppt/renderer",
  "version": "0.2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "assets/fonts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemonforme/lemonPPT.git",
    "directory": "packages/renderer"
  },
  "bugs": {
    "url": "https://github.com/lemonforme/lemonPPT/issues"
  },
  "homepage": "https://github.com/lemonforme/lemonPPT#readme",
  "scripts": {
    "build": "tsc && esbuild src/client-render.ts --bundle --platform=browser --format=iife --global-name=__lemonPPT_clientRender --outfile=dist/client/client-render.js --alias:react-dom/server=react-dom/server.browser --target=es2019 --minify && esbuild src/theme-echarts.ts --bundle --platform=browser --format=iife --outfile=dist/client/theme-echarts.js --target=es2019 --minify",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsc"
  },
  "dependencies": {
    "@lemonppt/core": "workspace:*",
    "@lemonppt/templates": "workspace:*",
    "@lemonppt/themes": "workspace:*",
    "playwright": "^1.61.1",
    "pptxgenjs": "3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.5.0"
  },
  "license": "AGPL-3.0"
}
